# Disposable EL9/EL10 proof: compile MapLibre Native's Node addon from upstream source.
# Build once per EL major release; do not reuse an EL9 native module in an EL10 runtime.
# This is intentionally a builder-only image; it does not replace the TileServer runtime.
ARG BASE_IMAGE=docker.io/rockylinux/rockylinux:9.8
ARG MAX_NODE_ABI=137
FROM ${BASE_IMAGE} AS builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /src
ARG MAX_NODE_ABI

# Match the upstream Linux Node build's required capabilities with EL9 package names.
# The first build is deliberately allowed to expose unavailable/misnamed EL packages.
RUN dnf install -y --setopt=install_weak_deps=False dnf-plugins-core \
    && dnf config-manager --set-enabled crb \
    && dnf install -y --setopt=install_weak_deps=False \
      clang \
      cmake \
      gcc \
      gcc-c++ \
      git \
      libcurl-devel \
      libicu-devel \
      libjpeg-turbo-devel \
      libpng-devel \
      libuv-devel \
      libwebp-devel \
      libX11-devel \
      mesa-libGL-devel \
      ninja-build \
      pkgconf-pkg-config \
      tar \
      which \
    && dnf clean all \
    && rm -rf /var/cache/dnf

COPY . /src

# The upstream preset is Linux-generic; it builds the Node addon for its supported Node ABIs.
# GLFW is upstream's interactive test/demo platform; server-side Node rendering does not require it.
RUN cmake --preset linux-opengl-node -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER_LAUNCHER= -DMLN_WITH_GLFW=OFF -DNODE_MODULE_MAXIMUM_ABI="${MAX_NODE_ABI}" \
    && cmake --build build -j "$(nproc)" \
    && find platform/node/lib -type f -name mbgl.node -print \
    && for addon in platform/node/lib/node-v*/mbgl.node; do \
         test -f "$addon"; \
         echo "=== $addon ==="; \
         ldd "$addon"; \
       done

# Test-only stage: keep Node/npm and the virtual display out of the builder image.
# Node 22 has module ABI 127, one of the ABIs compiled above. Verify its tarball.
FROM builder AS test
ARG NODE_VERSION=22.23.1
ARG NODE_SHA256=7a8cb04b4a1df4eaf432125324b81b29a088e73570a23259a8de1c65d07fc129
RUN dnf install -y --setopt=install_weak_deps=False xorg-x11-server-Xvfb \
    && mkdir -p /opt/node \
    && curl --fail --location --retry 4 --output /tmp/node.tar.gz \
         "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" \
    && printf '%s  %s\n' "${NODE_SHA256}" /tmp/node.tar.gz | sha256sum --check - \
    && tar -xzf /tmp/node.tar.gz -C /opt/node --strip-components=1 \
    && rm /tmp/node.tar.gz \
    && dnf clean all
ENV PATH="/opt/node/bin:${PATH}"
RUN cd /src/platform/node && npm ci --ignore-scripts
